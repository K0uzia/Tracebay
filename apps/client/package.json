{
  "name": "Tracebay",
  "version": "3.8.0",
  "main": "main.js",
  "homepage": "https://github.com/K0uzia/Tracebay#readme",
  "description": "Tracebay : traçabilité de matériel (lots, disques, archives) et agenda",
  "author": "Kouzia",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pdfkit": "^0.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "dev:debug": "cross-env NODE_ENV=development ELECTRON_ENABLE_LOGGING=1 electron .",
    "build": "npx electron-builder --publish=never",
    "build:dev": "NODE_ENV=development npx electron-builder --dir",
    "build:dev:win": "NODE_ENV=development npx electron-builder --dir --win",
    "build:dev:mac": "NODE_ENV=development npx electron-builder --dir --mac",
    "build:dev:linux": "NODE_ENV=development npx electron-builder --dir --linux",
    "build:prod": "cross-env NODE_ENV=production npx electron-builder --publish=always",
    "build:prod:win": "cross-env NODE_ENV=production npx electron-builder --win --publish=always",
    "build:prod:mac": "cross-env NODE_ENV=production npx electron-builder --mac --publish=always",
    "build:prod:linux": "cross-env NODE_ENV=production npx electron-builder --linux --publish=always",
    "build:prod:linux:local": "cross-env NODE_ENV=production npx electron-builder --linux --publish=never",
    "build:win": "npx electron-builder --win --publish=never",
    "build:mac": "npx electron-builder --mac --publish=never",
    "build:linux": "npx electron-builder --linux",
    "build:linux:release": "cross-env NODE_ENV=production npx electron-builder --linux --publish=always",
    "build:linux:publish": "node ../../scripts/run-with-env.js npm run build:linux:publish:inner -w apps/client",
    "build:linux:publish:inner": "cross-env NODE_ENV=production npx electron-builder --linux --publish=always",
    "install-desktop-dev": "node scripts/install-desktop-dev.js",
    "lint": "eslint . --ext .js",
    "audit": "npm audit",
    "audit:fix": "npm audit --fix"
  },
  "build": {
    "appId": "com.Tracebay.client",
    "productName": "Tracebay",
    "copyright": "Copyright © 2026 Alexandre Kouziaeff, entrepreneur individuel (Kouzia)",
    "electronVersion": "39.2.4",
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.2"
    },
    "publish": {
      "provider": "github",
      "owner": "K0uzia",
      "repo": "Tracebay",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "branding.js",
      "licence.js",
      "licence-cle-publique.js",
      "atelier.js",
      "linux-update.js",
      "config/**/*",
      "assets/**/*",
      "public/**/*",
      "!public/**/*.test.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "beforePack": "./scripts/third-party-licenses.js",
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/windows/icon.ico",
      "artifactName": "Tracebay-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tracebay",
      "include": "build/installer.nsh",
      "installerIcon": "assets/windows/icon.ico",
      "uninstallerIcon": "assets/windows/icon.ico",
      "installerHeaderIcon": "assets/windows/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Tracebay-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/macos/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/macos/icon-1024.png",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "maintainer": "Kouzia (Alexandre Kouziaeff) <k0uzia@users.noreply.github.com>",
      "executableName": "workspace",
      "synopsis": "Tracebay : traçabilité de matériel informatique",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/linux/icons",
      "category": "Utility",
      "artifactName": "workspace.${ext}",
      "desktop": {
        "entry": {
          "Name": "Tracebay",
          "Comment": "Tracebay : traçabilité de matériel informatique",
          "Categories": "Utility;",
          "StartupWMClass": "workspace"
        }
      }
    },
    "appImage": {
      "artifactName": "workspace.${ext}"
    },
    "deb": {
      "packageCategory": "utils",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4t64 | libnotify4",
        "libnss3",
        "libxss1t64 | libxss1",
        "libxtst6t64 | libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0t64 | libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ],
      "priority": "optional",
      "artifactName": "workspace.${ext}",
      "fpm": [
        "--name",
        "workspace",
        "--replaces",
        "Tracebay",
        "--conflicts",
        "Tracebay",
        "--provides",
        "Tracebay"
      ]
    },
    "rpm": {
      "artifactName": "workspace.${ext}",
      "fpm": [
        "--name",
        "workspace",
        "--replaces",
        "Tracebay",
        "--conflicts",
        "Tracebay",
        "--provides",
        "Tracebay",
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K0uzia/Tracebay.git"
  },
  "bugs": {
    "url": "https://github.com/K0uzia/Tracebay/issues"
  }
}
