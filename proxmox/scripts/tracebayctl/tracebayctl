#!/usr/bin/env bash
# tracebayctl : exploitation du serveur Tracebay (API Fastify + PostgreSQL sous Docker Compose).
# Sans argument dans un terminal : menu. « tracebayctl help » : liste des commandes.

# shellcheck source-path=SCRIPTDIR
set -euo pipefail

TB_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
TB_SELF_DIR="$(dirname "$TB_SELF")"

# shellcheck source=lib.sh
. "$TB_SELF_DIR/lib.sh"
# shellcheck source=status.sh
. "$TB_SELF_DIR/status.sh"
# shellcheck source=backup.sh
. "$TB_SELF_DIR/backup.sh"
# shellcheck source=update.sh
. "$TB_SELF_DIR/update.sh"
# shellcheck source=secrets.sh
. "$TB_SELF_DIR/secrets.sh"
# shellcheck source=atelier.sh
. "$TB_SELF_DIR/atelier.sh"
# shellcheck source=install.sh
. "$TB_SELF_DIR/install.sh"

usage() {
  cat <<'EOF'
Usage : tracebayctl <commande> [options]
        tracebayctl            (menu, dans un terminal)

Consultation
  status                 État complet : conteneurs, version, API, licence, atelier, Node, disque, sauvegardes.
  check                  Valide Docker, docker-compose.yml et les secrets du .env, sans rien modifier.
  logs [api|db] [-f] [-n N]
                         Journaux de l'API (par défaut) ou de PostgreSQL, 200 lignes, -f pour suivre.
  users                  Comptes : id, nom, rôle, date de création, mot de passe défini (jamais le hachage).

Mise à jour
  update [--yes] [--skip-backup] [--force] [--no-db-pull]
                         Sauvegarde obligatoire, nouvelle version de la branche proxmox, image construite
                         avant de toucher aux conteneurs ; retour automatique à la version d'avant si échec.

Sauvegardes
  backup [--tag X]       Sauvegarde vérifiée de la base (pg_dump), 14 gardées ; affiche son chemin.
  restore [SAUVEGARDE]   Remplace la base par une sauvegarde (choix dans la liste sans argument),
                         après une sauvegarde de sécurité de l'état actuel. --check : vérifier seulement.

Secrets
  rotate-secrets [--yes] Nouveaux JWT_SECRET, ADMIN_TOKEN et mot de passe PostgreSQL ; tout est remis
                         comme avant si une étape échoue.

Atelier et comptes
  set-branding --nom NOM [--logo FICHIER | --retirer-logo]
                         Nom et logo (PNG, JPEG, WebP, 512 Ko) imprimés sur les PDF de tous les postes.
  set-licence CLE        Clé de licence de l'atelier (TB1...), vérifiée par le serveur ; - pour la lire sur stdin.
  admin-password NOM     Nouveau mot de passe d'un compte, saisi deux fois sans affichage.
  admin-code             Code administrateur des postes (changer l'adresse du serveur sur un poste),
                         saisi deux fois sans affichage.
  user-delete [--yes] NOM
                         Supprime un compte après confirmation ; journal d'activité anonymisé.

Installation et maintenance
  install [--sans-cron]  Première installation ou réparation : .env aux secrets aléatoires s'il manque,
                         image, base et schémas, service systemd, commande tracebayctl (volume conservé).
  install-cli [--sans-cron]
                         Installe ou rafraîchit la commande (/usr/local/bin/tracebayctl et proxmox),
                         propose de corriger l'origin, active la sauvegarde quotidienne (3 h 17).
  cron on|off|status     Sauvegarde quotidienne.
  start | stop | restart Marche et arrêt (service systemd s'il existe, sinon docker compose).
  rebuild                Reconstruit l'image et redémarre l'API, code inchangé.
  test-api               Contrôles sans écriture : santé, base, licence, routes protégées refusées.
  diag                   status puis derniers journaux de l'API et de PostgreSQL.
  purge                  Caches Docker et images pendantes ; volume PostgreSQL jamais touché.
  destroy-db-volume      Supprime la base (variable I_ACCEPT_DESTROY_ALL_DATABASE_DATA obligatoire).
  uninstall-cli          Retire la commande installée (dépôt, base et sauvegardes intacts).

Aide
  help                   Cette aide.
  <commande> -h          Aide d'une commande.

Codes de sortie : 0 réussi, 1 erreur, 2 usage incorrect, 75 opération déjà en cours, 130 interruption.
EOF
}

usage_cmd() {
  case "$1" in
    status)
      cat <<'EOF'
tracebayctl status
  Lecture seule, sans verrou. Les secrets sont affichés « renseigné » ou avec leur défaut, jamais leur valeur.
  Les points à regarder sont en jaune et comptés à la fin.
EOF
      ;;
    check)
      cat <<'EOF'
tracebayctl check
  docker compose config -q, secrets du .env (vides, connus ou trop courts) et droits 600 du .env.
  Lancé aussi avant chaque opération qui utilise compose ou le .env.
EOF
      ;;
    update)
      cat <<'EOF'
tracebayctl update [--yes] [--skip-backup] [--force] [--no-db-pull]
  1. Contrôles (Docker, compose, secrets), git fetch et liste des nouveautés, confirmation.
  2. Sauvegarde obligatoire (étiquette avant-maj) : si elle échoue, arrêt, rien n'a changé.
     --skip-backup s'en passe, après une seconde confirmation.
  3. Code de la nouvelle version (git reset --hard origin/proxmox), puis suite avec ses propres scripts.
  4. Compose de la nouvelle version validé, image construite pendant que l'ancienne tourne :
     en cas d'échec, retour au code d'avant, rien n'a changé.
  5. Mot de passe PostgreSQL réaligné, schema.sql et migrations embarquées (erreur : avertissement
     noté dans status), redémarrage, santé de l'API et accès à la base.
     En cas d'échec : retour à la version d'avant, et la sauvegarde à restaurer est indiquée.
  Après la construction : dernière image PostgreSQL de la même étiquette (postgres:16-bookworm, jamais
  une autre majeure) ; PostgreSQL n'est redémarré que si elle a changé. --no-db-pull pour s'en passer.
  --force : reconstruit et redémarre même sans nouveau commit.
  L'API n'est jamais laissée arrêtée, même après une interruption.
EOF
      ;;
    rotate-secrets)
      cat <<'EOF'
tracebayctl rotate-secrets [--yes]
  Génère JWT_SECRET, ADMIN_TOKEN (32 octets) et DB_PASSWORD (24 octets). Ordre : copie du .env
  (.env.avant-rotation), mot de passe du rôle PostgreSQL changé, nouveau .env écrit d'un bloc,
  redémarrage, contrôle de l'API et de l'accès à la base. Si une étape échoue ou en cas
  d'interruption : ancien .env et ancien mot de passe PostgreSQL remis, conteneurs relancés.
  Fonctionne aussi quand les secrets actuels sont absents ou faibles (c'est le remède).
  Tous les utilisateurs devront se reconnecter.
EOF
      ;;
    logs)
      cat <<'EOF'
tracebayctl logs [api|db] [-f] [-n N]
  docker compose logs de l'API (défaut) ou de PostgreSQL ; 200 dernières lignes, -f (ou live) pour suivre.
EOF
      ;;
    users)
      cat <<'EOF'
tracebayctl users
  Liste des comptes lue dans PostgreSQL, colonnes choisies : le hachage du mot de passe n'est jamais lu.
EOF
      ;;
    set-branding)
      cat <<'EOF'
tracebayctl set-branding --nom "NOM DE L'ATELIER" [--logo FICHIER | --retirer-logo]
tracebayctl set-branding "NOM" [FICHIER]          (ancienne forme, acceptée)
  Contrôle local (nom de 120 caractères au plus, logo PNG, JPEG ou WebP de 512 Ko au plus, pas de SVG),
  puis PUT /api/admin/branding : le serveur valide à son tour. Une licence valide impose son nom sur les PDF.
EOF
      ;;
    set-licence)
      cat <<'EOF'
tracebayctl set-licence "TB1...."
tracebayctl set-licence -          (clé lue sur l'entrée standard)
  Envoie la clé au serveur (PUT /api/admin/licence), qui vérifie la signature ; affiche l'état obtenu.
EOF
      ;;
    admin-password)
      cat <<'EOF'
tracebayctl admin-password NOM
  Saisie masquée, deux fois, 12 caractères au moins (sans terminal : une ligne sur l'entrée standard).
  Le serveur hache le mot de passe (bcrypt) ; rien n'est affiché ni passé en argument.
EOF
      ;;
    admin-code)
      cat <<'EOF'
tracebayctl admin-code
  Saisie masquée, deux fois (sans terminal : une ligne sur l'entrée standard). 12 caractères au moins ;
  le serveur refuse les répétitions, les suites (abcdef, 123456, azerty) et les mots de passe courants.
  Le serveur n'en garde qu'une empreinte scrypt (N=32768), envoyée aux postes : ils vérifient le code
  même serveur injoignable. Le verrou protège contre l'erreur, pas contre qui a les droits du poste.
EOF
      ;;
    user-delete)
      cat <<'EOF'
tracebayctl user-delete [--yes] NOM
  Nom exact, sinon insensible à la casse s'il n'y a qu'un compte. Confirmation qui nomme le compte, puis
  DELETE /api/admin/users/:id : le journal d'activité ne garde que l'action et la date.
EOF
      ;;
    backup)
      cat <<'EOF'
tracebayctl backup [--tag ETIQUETTE] [--attendre]
  Sauvegarde de la base dans proxmox/docker/backups/AAAAMMJJ-HHMMSS[-ETIQUETTE]/ (db.sql.gz et
  manifest.txt), vérifiée (gzip, fin de dump) avant d'être gardée. Les 14 plus récentes sont gardées
  (TB_BACKUP_KEEP). Sortie standard : le chemin de la sauvegarde, seul.
  --attendre : attend jusqu'à 10 minutes la fin d'une autre opération (sauvegarde quotidienne).
EOF
      ;;
    restore)
      cat <<'EOF'
tracebayctl restore [--yes] [SAUVEGARDE]
tracebayctl restore --check [SAUVEGARDE]
  SAUVEGARDE : dossier (ou son nom) de proxmox/docker/backups, ou ancien fichier pre_update_*.sql.gz.
  Sans argument : liste numérotée des 15 dernières. Confirmation, sauvegarde de sécurité de l'état
  actuel, API arrêtée pendant l'import, puis redémarrée. Si l'import échoue, la base est remise
  dans son état d'avant. --check vérifie la sauvegarde sans rien toucher.
EOF
      ;;
    install)
      cat <<'EOF'
tracebayctl install [--yes] [--sans-cron]
  Installation ou réparation sur un dépôt déjà cloné (le code n'est pas mis à jour : tracebayctl update).
  Crée proxmox/docker/.env s'il manque (secrets aléatoires, e-mail proposé dans un terminal), construit
  l'image, démarre PostgreSQL, aligne son mot de passe, applique les schémas, installe le service
  systemd, démarre l'API, puis install-cli. Le volume PostgreSQL existant est conservé.
EOF
      ;;
    install-cli)
      cat <<'EOF'
tracebayctl install-cli [--yes] [--sans-cron]
  Copie les scripts dans /usr/local/lib/tracebay (dossier neuf puis échange), pose les commandes
  /usr/local/bin/tracebayctl et /usr/local/bin/proxmox (ancien nom, mène à tracebayctl), écrit
  /etc/tracebay/tracebayctl.conf (dossier du dépôt), propose de corriger l'origin du dépôt et active
  la sauvegarde quotidienne (/etc/cron.d/tracebay-backup) sauf avec --sans-cron.
  update rafraîchit la copie installée tout seul.
EOF
      ;;
    cron)
      cat <<'EOF'
tracebayctl cron on|off|status
  Sauvegarde quotidienne à 3 h 17 (tracebayctl backup --tag quotidien --attendre), 14 gardées,
  journal /var/log/tracebay-backup.log.
EOF
      ;;
    *) usage ;;
  esac
}

menu() {
  local choix
  while true; do
    cat >&2 <<'EOF'

Tracebay : que faire ?
  1  État du serveur
  2  Mettre à jour
  3  Sauvegarder la base
  4  Restaurer une sauvegarde
  5  Journaux de l'API
  6  Comptes
  7  Renouveler les secrets
  8  Vérifier la configuration
  9  Purge légère (caches Docker, base intacte)
  10 Installation ou réparation
  q  Quitter
EOF
    read -r -p "Choix : " choix || exit 0
    case "$choix" in
      1) ("$TB_SELF" status) || true ;;
      2) ("$TB_SELF" update) || true ;;
      3) ("$TB_SELF" backup > /dev/null) || true ;;
      4) ("$TB_SELF" restore) || true ;;
      5) ("$TB_SELF" logs) || true ;;
      6) ("$TB_SELF" users) || true ;;
      7) ("$TB_SELF" rotate-secrets) || true ;;
      8) ("$TB_SELF" check) || true ;;
      9) ("$TB_SELF" purge) || true ;;
      10) ("$TB_SELF" install) || true ;;
      q | Q) exit 0 ;;
      *) warn "Choix inconnu : $choix" ;;
    esac
  done
}

# Ancienne commande « proxmox » (relais posé par install-cli) : mêmes noms qu'avant, menés à tracebayctl.
traduire_ancien_cli() {
  [[ -n "${TB_LOCK_HELD:-}" ]] || info "La commande proxmox est remplacée par tracebayctl (tracebayctl help)."
  case "${1:-status}" in
    endpoints)
      info "Liste des routes retirée : voir docs/API.md dans le dépôt."
      exit 0
      ;;
    debug | diag) TB_ARGS=(diag "${@:2}") ;;
    api-test) TB_ARGS=(test-api) ;;
    *) TB_ARGS=("${1:-status}" "${@:2}") ;;
  esac
}

main() {
  trap_signals
  if [[ "${TB_APPEL:-}" == "proxmox" ]]; then
    traduire_ancien_cli "$@"
    set -- "${TB_ARGS[@]}"
  fi
  if [[ $# -eq 0 ]]; then
    if [[ -t 0 ]]; then
      tb_resolve_repo
      menu
    fi
    usage >&2
    exit 2
  fi
  local commande="$1"
  shift
  case "$commande" in
    help | -h | --help)
      usage
      return 0
      ;;
  esac
  tb_resolve_repo
  case "$commande" in
    status) cmd_status "$@" ;;
    check) cmd_check "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    update) cmd_update "$@" ;;
    rotate-secrets) cmd_rotate_secrets "$@" ;;
    set-branding) cmd_set_branding "$@" ;;
    set-licence) cmd_set_licence "$@" ;;
    logs) cmd_logs "$@" ;;
    users) cmd_users "$@" ;;
    admin-password) cmd_admin_password "$@" ;;
    admin-code) cmd_admin_code "$@" ;;
    user-delete) cmd_user_delete "$@" ;;
    install) cmd_install "$@" ;;
    install-cli) cmd_install_cli "$@" ;;
    uninstall-cli) cmd_uninstall_cli "$@" ;;
    cron) cmd_cron "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    purge | purge-safe) cmd_purge "$@" ;;
    destroy-db-volume) cmd_destroy_db_volume "$@" ;;
    test-api | api-test) cmd_test_api "$@" ;;
    diag | debug) cmd_diag "$@" ;;
    restore-backup) cmd_restore "$@" ;;
    menu)
      menu
      ;;
    *)
      usage >&2
      die "Commande inconnue : $commande" 2
      ;;
  esac
}

main "$@"
